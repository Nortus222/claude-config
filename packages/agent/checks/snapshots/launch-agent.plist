<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nortuscc.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/node/bin/node</string>
    <string>/Users/me/claude config/bin/nortuscc.mjs</string>
    <string>agent</string>
    <string>run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NORTUSCC_STATE_DIR</key>
    <string>/Users/me/.config/nortuscc</string>
    <key>PATH</key>
    <string>/usr/bin:/bin</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/me/claude config</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/me/.config/nortuscc/agent/agent.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/me/.config/nortuscc/agent/agent.log</string>
</dict>
</plist>
