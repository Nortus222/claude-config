{
  "name": "@nortuscc/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keeps a machine on its apply policy: schedules inspections, classifies accepted items and auto-applies only inert ones",
  "exports": { ".": "./src/index.ts", "./ipc/protocol": "./src/ipc/protocol.ts" },
  "scripts": {
    "test": "node --test --test-concurrency=2 \"checks/*.spec.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nortuscc/hosted-client": "0.1.0",
    "@nortuscc/hosted-protocol": "0.1.0",
    "@nortuscc/machine": "0.1.0",
    "@nortuscc/profile-engine": "0.1.0",
    "@nortuscc/sync": "0.1.0",
    "effect": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
