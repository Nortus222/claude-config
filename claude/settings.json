{
  "permissions": {
    "allow": [
      "Bash(dotnet test:*)",
      "Bash(dotnet build:*)",
      "Bash(ls:*)",
      "Bash(cd:*)",
      "Bash(mkdir:*)",
      "Bash(echo:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(git -C:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git config:*)",
      "Bash(git submodule:*)",
      "Bash(dart analyze:*)",
      "Bash(bash ~/.claude/bin/sdd-pkg.sh:*)",
      "Bash(~/.claude/bin/sdd-pkg.sh:*)",
      "Bash(bash ~/.claude/bin/sp:*)",
      "Bash(~/.claude/bin/sp:*)",
      "Read(~/.claude/plugins/cache/claude-plugins-official/superpowers/**)",
      "Read(/tmp/**)",
      "Read(//tmp/**)",
      "Read(/private/tmp/**)",
      "Read(//private/tmp/**)",
      "Write(**/*.md)",
      "Edit(**/*.md)",
      "Write(**/.git/**)",
      "Edit(**/.git/**)",
      "Write(.git/**)",
      "Edit(.git/**)"
    ],
    "additionalDirectories": [
      "/Users/nortus/Developer/emanageOne"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/hooks/context-mode-cache-heal.mjs\" ] && node \"$HOME/.claude/hooks/context-mode-cache-heal.mjs\" || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "context-mode@context-mode": true,
    "claude-mem@thedotmack": true
  },
  "extraKnownMarketplaces": {
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "auto",
  "agentPushNotifEnabled": true
}
