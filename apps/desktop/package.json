{
  "name": "nortuscc-desktop-validation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "tsx --test checks/*.spec.ts",
    "test:bun": "bun test ./checks/fixture.spec.ts ./checks/controller.spec.ts && FIXTURE_RUNTIME=\"$PWD/src-tauri/resources/darwin-arm64/bun\" tsx --test checks/backend.spec.ts",
    "typecheck": "tsc --noEmit",
    "resources": "node scripts/bundle.mjs",
    "build": "npm run typecheck && vite build && npm run resources",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "effect": "4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@tauri-apps/api": "2.12.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.2",
    "typescript": "7.0.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
