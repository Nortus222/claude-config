{
  "name": "nortuscc-desktop-validation",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "tsx --test --test-concurrency=2 checks/*.spec.ts",
    "test:resources": "node scripts/resource-check.mjs",
    "test:bun": "bun test ./checks/copy.spec.ts ./checks/line-diff.spec.ts ./checks/protocol.spec.ts ./checks/controller.spec.ts ./checks/setup-controller.spec.ts ./checks/account-controller.spec.ts ./checks/views.spec.ts ./checks/profile-choice.spec.ts ./checks/home-controller.spec.ts ./checks/home-view.spec.ts ./checks/update-controller.spec.ts ./checks/update-view.spec.ts ./checks/startup-diagnostics.spec.ts ./checks/startup-protocol.spec.ts ./checks/entry-loader.spec.ts ./checks/login-environment.spec.ts ./checks/agent-entry.spec.ts ./checks/mcp-server.spec.ts ./checks/mcp-resources.spec.ts ./checks/mcp-launch.spec.ts ./checks/machines-controller.spec.ts ./checks/machines-view.spec.ts && npm run test:resources",
    "typecheck": "tsc --noEmit",
    "resources": "node scripts/bundle.mjs",
    "build": "npm run typecheck && vite build && npm run resources",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:windows": "tauri build --config src-tauri/tauri.local-windows.conf.json",
    "smoke": "node scripts/smoke.mjs",
    "smoke:windows": "node scripts/smoke-windows.mjs",
    "smoke:mcp": "node scripts/mcp-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@nortuscc/agent": "0.1.0",
    "@nortuscc/machine": "0.1.0",
    "@nortuscc/profile-engine": "0.1.0",
    "@nortuscc/sync": "0.1.0",
    "effect": "4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@tauri-apps/api": "2.12.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.2",
    "typescript": "7.0.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "engines": {
    "node": ">=24"
  }
}
