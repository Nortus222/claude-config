{
  "name": "@nortuscc/service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Embeddable hosted metadata service core",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "test": "node --test \"checks/*.spec.ts\"",
    "typecheck": "tsc --noEmit",
    "test:cosmos": "NORTUSCC_COSMOS_REQUIRED=1 node --test \"checks/cosmos-*.spec.ts\"",
    "test:image": "node --test \"checks/image*.spec.ts\"",
    "start": "node src/main.ts"
  },
  "dependencies": {
    "@azure/core-rest-pipeline": "1.25.0",
    "@azure/cosmos": "4.10.1",
    "@azure/identity": "4.13.3",
    "@nortuscc/hosted-protocol": "*",
    "effect": "4.0.1"
  },
  "devDependencies": {
    "@nortuscc/agent": "*",
    "@nortuscc/hosted-client": "*",
    "@nortuscc/machine": "*",
    "@nortuscc/sync": "*",
    "@types/node": "25.5.0",
    "typescript": "7.0.2"
  },
  "engines": { "node": ">=24" }
}
