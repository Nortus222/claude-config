    "effect": "4.0.1"
  },
  "devDependencies": {
    "@nortuscc/agent": "*",
    "@nortuscc/hosted-client": "*",
    "@nortuscc/machine": "*",
    "@nortuscc/sync": "*",
    "@types/node": "25.5.0",
    "typescript": "7.0.2"
  },
  "engines": { "node": ">=24" }
}
